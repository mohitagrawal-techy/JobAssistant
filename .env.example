# Copy to .env. docker-compose.yml supplies working development defaults for anything unset.

# Long random string used to sign login tokens. Generate with: openssl rand -hex 32
JWT_SECRET=change-me

# AI provider. "ollama" runs locally; "fake" returns canned data for tests.
# A hosted API can be added later as a new adapter in backend/app/ai/.
LLM_PROVIDER=ollama
# Chosen with backend/scripts/compare_models.py. Smaller models followed injected resume text.
LLM_MODEL=gpt-oss:20b
LLM_BASE_URL=http://host.docker.internal:11434

# Embeddings are configured separately because a hosted LLM may not offer them.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://host.docker.internal:11434

# Public address of the site, used in links sent by email.
APP_BASE_URL=http://localhost:5173
# Number of reverse proxies in front of the API. Login limits need this to see real client IPs.
TRUSTED_PROXY_COUNT=0

# Google sign-in. Leave both empty to hide the button. Setup steps are in the README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# "console" prints emails to the backend log, for development only. Use "smtp" for real delivery.
EMAIL_PROVIDER=console
EMAIL_FROM=Khoj <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
